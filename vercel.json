{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "build": {
        "env": {
            "PIP_NO_BINARY": "pandas",
            "PIP_ONLY_BINARY": ":none:"
        }
    }
}